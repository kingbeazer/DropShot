@using Microsoft.AspNetCore.SignalR.Client
@inject IMessagingService MessagingService
@inject IMessagingHubFactory HubFactory
@inject ICurrentUser CurrentUser
@inject ISiteAlertService SiteAlerts
@inject NavigationManager Navigation
@implements IAsyncDisposable

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
}
else if (_conversation is null)
{
    <MudText>Conversation not found.</MudText>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/messages"))" />
        @if (!string.IsNullOrEmpty(_conversation.OtherUserProfileImagePath))
        {
            <MudAvatar Size="Size.Small">
                <MudImage Src="@_conversation.OtherUserProfileImagePath" />
            </MudAvatar>
        }
        else
        {
            <MudAvatar Size="Size.Small" Style="background: var(--mud-palette-primary);">
                <MudIcon Icon="@Icons.Material.Filled.Face" Size="Size.Small" />
            </MudAvatar>
        }
        <MudText Typo="Typo.h5">@_conversation.OtherUserDisplayName</MudText>
    </MudStack>

    @if (_conversation.Status == ConversationStatus.Denied)
    {
        <MudText Color="Color.Secondary">This conversation is no longer available.</MudText>
    }
    else if (_conversation.Status == ConversationStatus.PendingApproval && !_conversation.IsRequester)
    {
        <MudPaper Class="pa-4 frosted-card" Elevation="0">
            <MudText Class="mb-3">This DropShot user wants to send you a message.</MudText>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Allow">Allow</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Deny">Deny</MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        @if (_conversation.Status == ConversationStatus.PendingApproval && _conversation.IsRequester)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3">
                Waiting for @_conversation.OtherUserDisplayName to approve your message request.
            </MudAlert>
        }

        <MudPaper Class="pa-3 mb-3 frosted-card" Elevation="0" Style="max-height:50vh; overflow-y:auto;">
            @if (_messages.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No messages yet.</MudText>
            }
            else
            {
                @foreach (var message in _messages)
                {
                    var isMine = message.SenderUserId == CurrentUser.UserId;
                    <MudStack Row="true" Justify="@(isMine ? Justify.FlexEnd : Justify.FlexStart)" Class="mb-2">
                        <MudPaper Class="pa-2" Elevation="1"
                                  Style="@($"max-width:70%; background:{(isMine ? "var(--mud-palette-primary)" : "var(--mud-palette-surface)")}; color:{(isMine ? "var(--mud-palette-primary-text)" : "inherit")};")">
                            <MudText Typo="Typo.body2">@message.Body</MudText>
                            <MudText Typo="Typo.caption" Class="@(isMine ? "mud-primary-text" : "")">@message.SentAt.ToLocalTime().ToString("g")</MudText>
                        </MudPaper>
                    </MudStack>
                }
            }
        </MudPaper>

        <MudStack Row="true" Spacing="2">
            <MudTextField @bind-Value="_draft" Placeholder="Type a message..." Variant="Variant.Outlined"
                          Disabled="@(_conversation.Status != ConversationStatus.Active)"
                          Immediate="true" OnKeyDown="OnKeyDown" FullWidth="true" />
            <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary"
                            Disabled="@(_conversation.Status != ConversationStatus.Active || string.IsNullOrWhiteSpace(_draft))"
                            OnClick="Send" />
        </MudStack>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private int? _loadedId;
    private bool _loading = true;
    private ConversationDetailDto? _conversation;
    private List<MessageDto> _messages = [];
    private string _draft = "";
    private HubConnection? _hub;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id) return;
        _loadedId = Id;
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        await DisconnectHub();

        _conversation = await MessagingService.GetConversationAsync(Id);
        _messages = _conversation is null ? [] : await MessagingService.GetMessagesAsync(Id, null, 50);
        _loading = false;

        if (_conversation is not null)
        {
            await MessagingService.MarkConversationReadAsync(Id);

            if (_conversation.Status != ConversationStatus.Denied &&
                (_conversation.Status == ConversationStatus.Active || _conversation.IsRequester))
            {
                await ConnectHub();
            }
        }
    }

    private async Task ConnectHub()
    {
        _hub = HubFactory.Create();
        _hub.On<int, MessageDto>("ReceiveMessage", (conversationId, message) =>
        {
            if (conversationId != Id) return;
            _messages.Add(message);
            InvokeAsync(StateHasChanged);
            _ = MessagingService.MarkConversationReadAsync(Id);
        });
        _hub.On<int, bool>("ConversationRequestResolved", (conversationId, approved) =>
        {
            if (conversationId != Id) return;
            InvokeAsync(Load);
        });

        await _hub.StartAsync();
        await _hub.SendAsync("JoinConversation", Id);
    }

    private async Task DisconnectHub()
    {
        if (_hub is null) return;
        try { await _hub.SendAsync("LeaveConversation", Id); } catch { }
        await _hub.DisposeAsync();
        _hub = null;
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_draft) || _conversation is null) return;
        var body = _draft;
        _draft = "";
        try
        {
            await MessagingService.SendMessageAsync(Id, body);
        }
        catch (Exception ex)
        {
            SiteAlerts.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await Send();
    }

    private async Task Allow()
    {
        await MessagingService.ApproveRequestAsync(Id);
        SiteAlerts.Add("Request approved.", Severity.Success);
        await Load();
    }

    private async Task Deny()
    {
        await MessagingService.DenyRequestAsync(Id);
        SiteAlerts.Add("Request denied.", Severity.Info);
        Navigation.NavigateTo("/messages");
    }

    public async ValueTask DisposeAsync() => await DisconnectHub();
}
